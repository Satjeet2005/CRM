# ForgeFlow Environment Configuration Example
# Copy to .env for local development: cp .env.example .env
# NEVER commit real credentials or secrets to version control.

# Application Environment: development | test | production
APP_ENV=development

# Demo Mode: true enables synthetic seed data and demo credentials helper.
# MUST be false in production.
DEMO_MODE=true

# Secret Key for cryptographic operations (min 32 characters in production)
APP_SECRET_KEY=forgeflow-local-development-secret-key-32chars-min!

# Host database port binding (defaults to 5434 to avoid port 5432 host collisions)
POSTGRES_PORT=5434

# PostgreSQL connection string for application runtime
# In Docker Compose, host is 'db:5432'. For local host runtime, host is 'localhost:5434'.
DATABASE_URL=postgresql+psycopg://forgeflow:forgeflow_dev@localhost:5434/forgeflow

# Dedicated PostgreSQL connection string for running automated tests.
# MUST NOT point to the primary application database.
TEST_DATABASE_URL=postgresql+psycopg://forgeflow:forgeflow_dev@localhost:5434/forgeflow_test

# Frontend Origin for CORS and strict CSRF Origin/Referer validation
FRONTEND_ORIGIN=http://localhost:3000

# Session and Cookie Configuration
SESSION_COOKIE_NAME=forgeflow_session
SESSION_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=60
CSRF_COOKIE_NAME=forgeflow_csrf

# Logging and Ingestion Caps
LOG_LEVEL=INFO
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=5000
MAX_RFQ_FILE_SIZE_BYTES=5242880
MAX_RFQ_DATA_ROWS=500
